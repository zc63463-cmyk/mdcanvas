#!/bin/sh
# MindCanvas · pre-push 门禁
#
# 跑全量 gate：typecheck（3 包） + test（794 个） + depcruise（架构守护）
# + lint（风格） + budget（债务预算：只减不增）。
# 耗时约 2-3 分钟 —— 推送是最后一道本地防线，值得等。
#
# 绕过（仅限紧急场景）：git push --no-verify

set -e

echo "▶ [pre-push] 全量门禁：typecheck + test + depcruise + lint + budget"
echo "  （约 2-3 分钟，可用 --no-verify 绕过）"

# pnpm 可用时走原命令；不可用时（受管 Node 沙箱无 pnpm shim，如 WorkBuddy/CI 受限环境）
# 回退到等价的直接二进制调用——门禁项目一项不少，只换 invocation。
# vitest 一律 timeout 兜底：沙箱下 hook 上下文偶发套件不退出（2026-09-06 实测
# 挂起 20+ 分钟），超时即判失败可重跑，绝不静默挂起；被杀任务残留的僵尸
# node 进程会加剧该问题（需人工清理）。
run_vitest() {
  timeout 480 node "$1" run --root "$2"
}
run_gate() {
  if command -v pnpm >/dev/null 2>&1; then
    pnpm gate
    return $?
  fi
  echo "  （pnpm 不可用，使用等价直调回退）"
  node packages/react/node_modules/typescript/bin/tsc -b \
    packages/kernel/tsconfig.json packages/react/tsconfig.json apps/canvas/tsconfig.json \
    --pretty false || return 1
  run_vitest packages/kernel/node_modules/vitest/vitest.mjs packages/kernel || return 1
  run_vitest packages/react/node_modules/vitest/vitest.mjs packages/react || return 1
  run_vitest apps/canvas/node_modules/vitest/vitest.mjs apps/canvas || return 1
  ./node_modules/.bin/depcruise packages apps --config .dependency-cruiser.js || return 1
  node node_modules/@biomejs/biome/bin/biome lint packages apps || return 1
  node scripts/check-code-budget.mjs || return 1
}

if ! run_gate; then
  echo ""
  echo "✗ 全量门禁未通过，推送已中止。"
  echo "  逐项排查："
  echo "   · pnpm typecheck    —— 类型错误"
  echo "   · pnpm test         —— 测试失败"
  echo "   · pnpm depcruise    —— 架构依赖违规"
  echo "   · pnpm lint         —— 代码风格 error"
  echo "   · pnpm budget       —— 代码债务超预算（只减不增）"
  echo ""
  echo "  紧急绕过（不推荐）：git push --no-verify"
  exit 1
fi

echo "✔ 全量门禁通过"
