#!/bin/sh
# MindCanvas · pre-push 门禁
#
# 跑全量 gate：typecheck（3 包） + test（755 个） + depcruise（架构守护）。
# 耗时约 2-3 分钟 —— 推送是最后一道本地防线，值得等。
#
# 绕过（仅限紧急场景）：git push --no-verify

set -e

echo "▶ [pre-push] 全量门禁：typecheck + test + depcruise"
echo "  （约 2-3 分钟，可用 --no-verify 绕过）"

if ! pnpm gate; then
  echo ""
  echo "✗ 全量门禁未通过，推送已中止。"
  echo "  逐项排查："
  echo "   · pnpm typecheck    —— 类型错误"
  echo "   · pnpm test         —— 测试失败"
  echo "   · pnpm depcruise    —— 架构依赖违规"
  echo ""
  echo "  紧急绕过（不推荐）：git push --no-verify"
  exit 1
fi

echo "✔ 全量门禁通过"
