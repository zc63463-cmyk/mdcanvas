#!/bin/sh
# MindCanvas · pre-push 门禁
#
# 跑全量 gate：typecheck（3 包） + test（794 个） + depcruise（架构守护）
# + lint（风格） + budget（债务预算：只减不增）。
# 耗时约 2-3 分钟 —— 推送是最后一道本地防线，值得等。
#
# 绕过（仅限紧急场景）：git push --no-verify

set -e

# 注意：`timeout ... || true` 的写法很关键 —— set -e 下 `timeout` 返回 124 会让
# 脚本当场退出，后面的判定逻辑根本执行不到（2026-09-10 实测踩坑）。

echo "▶ [pre-push] 全量门禁：typecheck + test + depcruise + lint + budget"
echo "  （约 2-3 分钟，可用 --no-verify 绕过）"

# pnpm 可用时走原命令；不可用时（受管 Node 沙箱无 pnpm shim，如 WorkBuddy/CI 受限环境）
# 回退到等价的直接二进制调用——门禁项目一项不少，只换 invocation。
#
# timeout 兜底：沙箱下 hook 上下文偶发「套件跑完但进程不退出」（2026-09-06 实测
# 挂起 20+ 分钟，被杀任务残留的僵尸 node 进程会加剧该问题）。
# 处理策略（2026-09-10 修正）：不再把所有超时一律判失败——那会在沙箱里 100% 误杀
# （测试其实全绿，只是进程不退出，退出码 124）。改为**看证据**：
#   · 退出码 0                                        → 通过
#   · 退出码 124（被 timeout 杀）且输出含失败标记      → 失败（真正的挂起/失败）
#   · 退出码 124 且输出无失败标记、有「Tests N passed」→ 通过（环境噪声，测试已跑完）
#   · 其他非零                                        → 失败
# 绝不静默挂起：timeout 仍在，最长等 480s。
run_vitest() {
  # 日志落仓库内固定路径（不用 mktemp）：MSYS 的 mktemp 返回 E:/DevTemp/... 这类
  # Windows 路径，套在 timeout 里时 node 的输出重定向会落空，导致「明明全通过
  # 却 grep 不到结果」的误判（2026-09-10 实测）。
  _log=".git/pre-push-vitest.log"
  _code=0
  : > "$_log"
  timeout 480 node "$1" run --root "$2" > "$_log" 2>&1 || _code=$?
  cat "$_log"
  # 结论以输出为准（退出码仅作辅助）：沙箱下进程不退出会得到 124，但用例其实已全跑完
  if grep -qE "Tests +[0-9]+ failed" "$_log" \
    || grep -qE "^ *FAIL |Unhandled Error|Test Files +[0-9]+ failed" "$_log"; then
    echo "  ✗ vitest 有失败用例 —— 判失败" >&2
    return 1
  fi
  if grep -qE "Tests +[0-9]+ passed" "$_log"; then
    if [ "$_code" -eq 0 ]; then
      return 0
    fi
    if [ "$_code" -eq 124 ]; then
      echo "  ⚠ vitest 超时退出（exit 124），但全部用例已通过 —— 判为沙箱进程不退出，放行"
      return 0
    fi
    echo "  ✗ vitest 非零退出（exit $_code）—— 判失败" >&2
    return 1
  fi
  # 既无通过也无失败标记：可能真挂起在启动阶段
  echo "  ✗ vitest 无结果输出（exit $_code）—— 判失败" >&2
  return 1
}
run_gate() {
  if command -v pnpm >/dev/null 2>&1; then
    pnpm gate
    return $?
  fi
  echo "  （pnpm 不可用，使用等价直调回退）"
  node packages/react/node_modules/typescript/bin/tsc -b \
    packages/kernel/tsconfig.json packages/react/tsconfig.json apps/canvas/tsconfig.json \
    --pretty false || return 1
  run_vitest packages/kernel/node_modules/vitest/vitest.mjs packages/kernel || return 1
  run_vitest packages/react/node_modules/vitest/vitest.mjs packages/react || return 1
  run_vitest apps/canvas/node_modules/vitest/vitest.mjs apps/canvas || return 1
  # depcruise 走真实 JS 入口：node_modules/.bin 下的 shell wrapper 在 Git Bash
  # 下会因 CRLF/路径转义报 "SyntaxError: missing ) after argument list"（2026-09-10 实测）
  node node_modules/dependency-cruiser/bin/dependency-cruise.mjs packages apps \
    --config .dependency-cruiser.js || return 1
  node node_modules/@biomejs/biome/bin/biome lint packages apps || return 1
  node scripts/check-code-budget.mjs || return 1
}

if ! run_gate; then
  echo ""
  echo "✗ 全量门禁未通过，推送已中止。"
  echo "  逐项排查："
  echo "   · pnpm typecheck    —— 类型错误"
  echo "   · pnpm test         —— 测试失败"
  echo "   · pnpm depcruise    —— 架构依赖违规"
  echo "   · pnpm lint         —— 代码风格 error"
  echo "   · pnpm budget       —— 代码债务超预算（只减不增）"
  echo ""
  echo "  紧急绕过（不推荐）：git push --no-verify"
  exit 1
fi

echo "✔ 全量门禁通过"
